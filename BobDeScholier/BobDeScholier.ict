      - type: template
        baseClass: AnimatedSprite
        name: speler
        depth: 0
        texture: zFp1nck318KfNW
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnStep
            lib: core
            code: |-
              if (actions.Links.down) {
                this.hspeed = -this.snelheid;
              } else if (actions.Rechts.down) {
                this.hspeed = this.snelheid;
              } else {
                this.hspeed = 0;
              }

              if (actions.Omhoog.down) {
                this.vspeed = -this.snelheid;
              } else if (actions.Omlaag.down) {
                this.vspeed = this.snelheid;
              } else {
                this.vspeed = 0;
              }

              this.moveSmart('Solid');
            arguments: {}
          - eventKey: OnCreate
            code: |
              this.snelheid = 480;
            arguments: {}
            lib: core
        extends:
          cgroup: ''
          'editor:myCollidingCGroups': []
