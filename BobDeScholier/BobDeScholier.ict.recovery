      - type: template
        baseClass: AnimatedSprite
        name: toets
        depth: 4
        texture: L1tToets000001
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnCreate
            code: |-
              this.basisY = this.y;
              this.tijd = Math.random() * 6;
            arguments: {}
            lib: core
          - eventKey: OnStep
            code: |-
              // Zachtjes op en neer zweven
              this.tijd += u.time * 3;
              this.y = this.basisY - 6 + Math.sin(this.tijd) * 4;
            arguments: {}
            lib: core
        extends:
          cgroup: ''
          'editor:myCollidingCGroups': []
        lastmod: 1793300000000
        uid: L1sToets000001
        behaviors: []
        extendTypes: ''
      - type: template
        baseClass: AnimatedSprite
        name: camera
        depth: 6
        texture: L1tCamera00001
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnCreate
            code: |-
              this.tijd = 0;
              this.bereik = 0.55; // hoe ver hij naar links/rechts draait (radialen)
              this.draaiSnelheid = 1.2;
              this.breedte = 30; // halve breedte van de lichtvlek op de vloer
              this.hoek = 0;
              this.raakX = this.x;
              // De camera gaat om de beurt aan en uit: dan kun je erlangs sluipen!
              this.aanDuur = 3;
              this.uitDuur = 2.5;
              this.klok = 0;
              this.aan = true;
            arguments: {}
            lib: core
          - eventKey: OnStep
            code: |-
              const L = (window as any).L1;
              if (!L || L.status !== 'spelen') {
                return;
              }
              if (this.vloer === undefined) {
                this.vloer = L.vloerOnder(this.x, this.y + 20);
              }
              const dt = u.time;

              // Aan / uit
              this.klok += dt;
              if (this.aan && this.klok >= this.aanDuur) {
                this.aan = false;
                this.klok = 0;
              } else if (!this.aan && this.klok >= this.uitDuur) {
                this.aan = true;
                this.klok = 0;
              }
              this.tint = this.aan ? 0xffffff : 0x777777;

              // Heen en weer draaien
              if (this.aan) {
                this.tijd += dt * this.draaiSnelheid;
              }
              this.hoek = Math.sin(this.tijd) * this.bereik;
              this.rotation = -this.hoek;
              this.raakX = this.x + Math.tan(this.hoek) * (this.vloer - this.y);

              // --- Ziet hij Bob? ---
              const p = templates.list['bob'][0];
              if (this.aan && p && !p.verstopt) {
                const b = L.spelerBox(p);
                const pm = b.l + b.w / 2;
                const voeten = b.t + b.h;
                if (voeten > this.y && voeten <= this.vloer + 2 &&
                    Math.abs(pm - this.raakX) < this.breedte + b.w / 4) {
                  L.betrapt('De camera heeft je gezien!');
                }
              }
            arguments: {}
            lib: core
        extends:
          cgroup: ''
          'editor:myCollidingCGroups': []
        lastmod: 1793300000000
        uid: L1sCamera00001
        behaviors: []
        extendTypes: ''
      - type: template
        baseClass: AnimatedSprite
        name: leraar
        depth: 8
        texture: L1tLeraar00001
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnCreate
            code: |-
              this.richting = 1; // 1 = rechts, -1 = links
              this.snelheid = 80;
              this.zicht = 220;
              this.zichtNu = this.zicht;
              this.pauze = 0;
              this.alarm = false;
              // Loopt 240 pixels heen en weer rond zijn startplek
              this.links = this.x - 240;
              this.rechts = this.x + 240;
            arguments: {}
            lib: core
          - eventKey: OnStep
            code: |-
              const L = (window as any).L1;
              if (!L || L.status !== 'spelen') {
                return;
              }
              const dt = u.time;

              // --- Patrouilleren ---
              if (this.pauze > 0) {
                this.pauze -= dt;
                if (this.pauze <= 0) {
                  this.richting *= -1;
                }
              } else {
                this.x += this.richting * this.snelheid * dt;
                if (this.richting > 0 && this.x >= this.rechts) {
                  this.x = this.rechts;
                  this.pauze = 1.2;
                } else if (this.richting < 0 && this.x <= this.links) {
                  this.x = this.links;
                  this.pauze = 1.2;
                }
              }
              this.scale.x = Math.abs(this.scale.x) * this.richting;

              // Zicht stopt bij een muur
              this.zichtNu = this.zicht;
              while (this.zichtNu > 0 && !L.vrijZicht(this.x, this.x + this.richting * this.zichtNu, this.y - 60)) {
                this.zichtNu -= 10;
              }

              // --- Ziet hij Bob? ---
              const p = templates.list['bob'][0];
              if (p && !p.verstopt) {
                const b = L.spelerBox(p);
                const pm = b.l + b.w / 2;
                const zelfdeVloer = Math.abs(b.t + b.h - this.y) < 12;
                const voor = (pm - this.x) * this.richting;
                if (zelfdeVloer && (Math.abs(pm - this.x) < 26 || (voor > 0 && voor - b.w / 2 < this.zichtNu))) {
                  this.alarm = true;
                  L.betrapt('De leraar heeft je gezien!');
                }
              }
            arguments: {}
            lib: core
        extends:
          cgroup: ''
          'editor:myCollidingCGroups': []
        lastmod: 1793300000000
        uid: L1sLeraar00001
        behaviors: []
        extendTypes: ''
      - type: template
        baseClass: AnimatedSprite
        name: bob
        depth: 10
        texture: zFp1nck318KfNW
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnCreate
            code: |-
              this.snelheid = 200;
              this.klimSnelheid = 150;
              this.vy = 0;
              this.verstopt = false;
              this.deurPauze = 0;
              this.uitgangPauze = 0;
            arguments: {}
            lib: core
          - eventKey: OnStep
            code: |-
              const L = (window as any).L1;
              if (!L || L.status !== 'spelen') {
                return;
              }
              const dt = u.time;
              const lijf = L.spelerBox(this);
              const W = lijf.w, H = lijf.h;
              const midden = () => this.x + W / 2;
              const voeten = () => this.y + H;
              this.deurPauze -= dt;
              this.uitgangPauze -= dt;

              // --- Verstopt in een kluisje ---
              if (this.verstopt) {
                if (actions.Actie.pressed) {
                  this.verstopt = false;
                  this.alpha = 1;
                }
                return;
              }

              // --- Op een ladder? ---
              let ladder = null;
              for (const l of templates.list['ladder']) {
                const b = L.box(l);
                if (Math.abs(midden() - (b.l + b.w / 2)) < 22 &&
                    voeten() >= b.t - 1 && voeten() <= b.t + b.h + 1) {
                  ladder = b;
                  break;
                }
              }
              const opGrond = L.vloerOp(this.x + 2, W - 4, voeten()) !== null;

              // --- Verstoppen (E) ---
              if (actions.Actie.pressed && opGrond) {
                for (const k of templates.list['kluisje']) {
                  if (L.overlapt(L.spelerBox(this), L.box(k))) {
                    this.verstopt = true;
                    this.alpha = 0.35;
                    this.x = k.x - W / 2;
                    L.meld('Verstopt! Druk op E om eruit te komen.', 1.5);
                    return;
                  }
                }
              }

              // --- Deur naar een andere verdieping (W) ---
              if (actions.Omhoog.pressed && opGrond && this.deurPauze <= 0) {
                for (const d of templates.list['deur']) {
                  if (d.partner && L.overlapt(L.spelerBox(this), L.box(d))) {
                    this.x = d.partner.x - W / 2;
                    this.y = d.partner.y - H;
                    this.vy = 0;
                    this.deurPauze = 0.4;
                    return;
                  }
                }
              }

              let dx = 0;
              if (actions.Links.down) {
                dx -= 1;
              }
              if (actions.Rechts.down) {
                dx += 1;
              }
              let dy = 0;
              if (actions.Omhoog.down) {
                dy -= 1;
              }
              if (actions.Omlaag.down) {
                dy += 1;
              }

              // --- Klimmen ---
              let klimt = false;
              if (ladder) {
                const boven = ladder.t, onder = ladder.t + ladder.h;
                const halverwege = voeten() > boven + 0.5 && voeten() < onder - 0.5;
                if ((dy < 0 && voeten() > boven + 0.5) || (dy > 0 && voeten() < onder - 0.5) || halverwege) {
                  klimt = true;
                  this.x = ladder.l + ladder.w / 2 - W / 2;
                  this.y += dy * this.klimSnelheid * dt;
                  // Binnen de ladder blijven
                  if (voeten() < boven) {
                    this.y = boven - H;
                  }
                  if (voeten() > onder) {
                    this.y = onder - H;
                  }
                  this.vy = 0;
                }
              }

              // --- Lopen ---
              if (!klimt && dx !== 0) {
                const nx = this.x + dx * this.snelheid * dt;
                const proef = { l: nx, t: this.y, w: W, h: H - 1 };
                if (!L.raaktMuur(proef)) {
                  this.x = nx;
                }
              }

              // --- Zwaartekracht ---
              if (!ladder && L.vloerOp(this.x + 2, W - 4, voeten()) === null) {
                const oud = voeten();
                this.vy += 1500 * dt;
                this.y += this.vy * dt;
                // Landen op een vloer
                for (const m of templates.list['muur']) {
                  const b = L.box(m);
                  if (this.x + 2 < b.l + b.w && this.x + W - 2 > b.l && oud <= b.t && voeten() >= b.t) {
                    this.y = b.t - H;
                    this.vy = 0;
                    break;
                  }
                }
              } else {
                this.vy = 0;
              }

              // --- Toetsen oprapen ---
              for (const t of templates.list['toets']) {
                if (!t.kill && L.overlapt(L.spelerBox(this), L.box(t))) {
                  t.kill = true;
                  L.toetsen += 1;
                  if (L.toetsen >= L.totaal) {
                    L.meld('Alle toetsen! Snel naar de groene uitgang!', 3);
                  } else {
                    L.meld('Toets gevonden! (' + L.toetsen + '/' + L.totaal + ')', 2);
                  }
                }
              }

              // --- Uitgang ---
              for (const e of templates.list['uitgang']) {
                if (L.overlapt(L.spelerBox(this), L.box(e))) {
                  if (L.toetsen >= L.totaal) {
                    L.win();
                  } else if (this.uitgangPauze <= 0) {
                    L.meld('De deur zit op slot. Je mist nog ' + (L.totaal - L.toetsen) + ' toets(en)!', 2);
                    this.uitgangPauze = 2;
                  }
                }
              }
            arguments: {}
            lib: core
        extends:
          cgroup: ''
          'editor:myCollidingCGroups': []
        lastmod: 1793300000000
        uid: L1sBob00000001
        behaviors: []
        extendTypes: ''
