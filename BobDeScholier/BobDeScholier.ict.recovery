            uid: L1sBob00000001
            exts: {}
            customProperties: {}
            customText: !<tag:yaml.org,2002:js/undefined> ''
            customSize: !<tag:yaml.org,2002:js/undefined> ''
            customWordWrap: !<tag:yaml.org,2002:js/undefined> ''
            bindings: {}
        tiles: []
        extends: {}
        lastmod: 1793300000000
        events:
          - eventKey: OnRoomStart
            code: |-
              // ===== Level 1: gedeelde spel-logica =====
              // Alle objecten in deze kamer gebruiken het object L1 hieronder.
              const L: any = {
                status: 'spelen', // 'spelen' | 'betrapt' | 'gewonnen'
                statusTijd: 0,
                tijd: 0,
                toetsen: 0,
                totaal: templates.list['toets'].length,
                melding: '',
                meldingTijd: 0
              };
              (window as any).L1 = L;

              // Rechthoek (links, boven, breedte, hoogte) van een kopie, rekening houdend met de as (anchor)
              L.box = (c) => {
                const w = Math.abs(c.width), h = Math.abs(c.height);
                return { l: c.x - c.anchor.x * w, t: c.y - c.anchor.y * h, w: w, h: h };
              };
              // Bob zijn lichaam (de afbeelding heeft veel lege ruimte rondom)
              L.spelerBox = (p) => {
                const s = Math.abs(p.scale.y);
                return { l: p.x, t: p.y, w: 188 * s, h: 415 * s };
              };
              L.overlapt = (a, b) =>
                a.l < b.l + b.w && a.l + a.w > b.l && a.t < b.t + b.h && a.t + a.h > b.t;
              L.raaktMuur = (box) => {
                for (const m of templates.list['muur']) {
                  if (!m.kill && L.overlapt(box, L.box(m))) {
                    return true;
                  }
                }
                return false;
              };
              // Bovenkant van de vloer net onder (x..x+w) op hoogte y, of null
              L.vloerOp = (x, w, y) => {
                for (const m of templates.list['muur']) {
                  const b = L.box(m);
                  if (x < b.l + b.w && x + w > b.l && Math.abs(b.t - y) < 1.5) {
                    return b.t;
                  }
                }
                return null;
              };
              // Eerste vloer onder punt (x, y)
              L.vloerOnder = (x, y) => {
                let beste = 99999;
                for (const m of templates.list['muur']) {
                  const b = L.box(m);
                  if (x >= b.l && x <= b.l + b.w && b.t >= y && b.t < beste) {
                    beste = b.t;
                  }
                }
                return beste;
              };
              // Staat er een muur tussen x1 en x2 op hoogte y?
              L.vrijZicht = (x1, x2, y) => {
                const links = Math.min(x1, x2), rechts = Math.max(x1, x2);
                for (const m of templates.list['muur']) {
                  const b = L.box(m);
                  if (b.l > links && b.l + b.w < rechts && y > b.t && y < b.t + b.h) {
                    return false;
                  }
                }
                return true;
              };
              L.meld = (tekst, duur) => {
                L.melding = tekst;
                L.meldingTijd = duur || 2;
              };
              L.betrapt = (reden) => {
                if (L.status !== 'spelen') {
                  return;
                }
                L.status = 'betrapt';
                L.statusTijd = 0;
                L.groot.text = 'BETRAPT!';
                L.klein.text = reden + '\nOpnieuw proberen...';
                L.overlay.visible = true;
              };
              L.win = () => {
                if (L.status !== 'spelen') {
                  return;
                }
                L.status = 'gewonnen';
                L.statusTijd = 0;
                L.groot.text = 'LEVEL GEHAALD!';
                L.klein.text = 'Tijd: ' + Math.floor(L.tijd) + ' seconden';
                L.overlay.visible = true;
              };

              // Pareer de deuren: deur 1 <-> deur 2, deur 3 <-> deur 4, ...
              const deuren = templates.list['deur'];
              for (let i = 0; i + 1 < deuren.length; i += 2) {
                deuren[i].partner = deuren[i + 1];
                deuren[i + 1].partner = deuren[i];
              }

              // Lichtbundels van leraren en camera's
              L.licht = new PIXI.Graphics();
              L.licht.zIndex = 5;
              this.addChild(L.licht);

              // HUD
              const stijl = {
                fontFamily: 'Arial, sans-serif',
                fontSize: 26,
                fontWeight: 'bold',
                fill: 0xffffff,
                stroke: 0x000000,
                strokeThickness: 5
              };
              L.hud = new PIXI.Text('', stijl);
              L.hud.x = 40;
              L.hud.y = 16;
              L.hud.zIndex = 1000;
              this.addChild(L.hud);

              L.hulp = new PIXI.Text('A/D lopen  W/S ladder & deur  E verstoppen  Esc terug', Object.assign({}, stijl, { fontSize: 18, strokeThickness: 4 }));
              L.hulp.anchor.set(1, 0);
              L.hulp.x = 1240;
              L.hulp.y = 22;
              L.hulp.zIndex = 1000;
              this.addChild(L.hulp);

              L.meldTekst = new PIXI.Text('', Object.assign({}, stijl, { fontSize: 24, fill: 0xffe066 }));
              L.meldTekst.anchor.set(0.5, 0);
              L.meldTekst.x = 640;
              L.meldTekst.y = 16;
              L.meldTekst.zIndex = 1000;
              this.addChild(L.meldTekst);

              L.overlay = new PIXI.Container();
              L.overlay.zIndex = 2000;
              L.overlay.visible = false;
              const vlak = new PIXI.Graphics();
              vlak.beginFill(0x000000, 0.6);
              vlak.drawRect(0, 0, 1280, 720);
              vlak.endFill();
              L.overlay.addChild(vlak);
              L.groot = new PIXI.Text('', Object.assign({}, stijl, { fontSize: 72, strokeThickness: 8 }));
              L.groot.anchor.set(0.5);
              L.groot.x = 640;
              L.groot.y = 300;
              L.overlay.addChild(L.groot);
              L.klein = new PIXI.Text('', Object.assign({}, stijl, { fontSize: 28, align: 'center' }));
              L.klein.anchor.set(0.5, 0);
              L.klein.x = 640;
              L.klein.y = 370;
              L.overlay.addChild(L.klein);
              this.addChild(L.overlay);

              this.sortableChildren = true;
              L.meld('Pak alle ' + L.totaal + ' toetsen en ontsnap via de groene deur!', 4);
            arguments: {}
            lib: core
          - eventKey: OnStep
            code: |-
              const L = (window as any).L1;
              if (!L) {
                return;
              }

              if (actions.Terug.pressed) {
                rooms.switch('Levels');
                return;
              }

              if (L.status === 'spelen') {
                L.tijd += u.time;
              } else {
                L.statusTijd += u.time;
                if (L.status === 'betrapt' && L.statusTijd > 1.8) {
                  rooms.switch('Level1');
                  return;
                }
                if (L.status === 'gewonnen' && L.statusTijd > 3) {
                  rooms.switch('Levels');
                  return;
                }
              }

              L.hud.text = 'Tijd: ' + Math.floor(L.tijd) + '    Toetsen: ' + L.toetsen + '/' + L.totaal;

              if (L.meldingTijd > 0) {
                L.meldingTijd -= u.time;
                L.meldTekst.text = L.melding;
                L.meldTekst.visible = true;
                L.hulp.visible = false;
              } else {
                L.meldTekst.visible = false;
                L.hulp.visible = true;
              }

              // Lichtbundels tekenen
              const g = L.licht;
              g.clear();
              for (const l of templates.list['leraar']) {
                if (l.kill) {
                  continue;
                }
                const r = l.richting;
                g.beginFill(0xfff3a0, l.alarm ? 0.45 : 0.18);
                g.drawPolygon([
                  l.x + r * 10, l.y - 82,
                  l.x + r * l.zichtNu, l.y - 110,
                  l.x + r * l.zichtNu, l.y
                ]);
                g.endFill();
              }
              for (const c of templates.list['camera']) {
                if (c.kill || c.vloer === undefined || !c.aan) {
                  continue;
                }
                g.beginFill(0x7dff9a, 0.22);
                g.drawPolygon([
                  c.x - 4, c.y + 18,
                  c.x + 4, c.y + 18,
                  c.raakX + c.breedte, c.vloer,
                  c.raakX - c.breedte, c.vloer
                ]);
                g.endFill();
              }
            arguments: {}
            lib: core
          - eventKey: OnRoomEnd
            code: |-
              (window as any).L1 = null;
            arguments: {}
            lib: core
        behaviors: []
        extendTypes: ''
        uid: cCfPGNHndWqBwj
